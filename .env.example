# --- Contact form (the only server-side feature on this static site) ---------
# Email goes out through GoDaddy Workspace Email (SMTP), signed in as the WonderApps
# mailbox. Only the password is required; the rest default to the values shown.
SMTP_PASS=
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_USER=connect@wonderapps.biz

# Comma-separated list of inboxes that receive every contact-form submission.
CONTACT_RECIPIENTS=connect@wonderapps.biz

# The From address. GoDaddy only relays mail sent from the signed-in mailbox, so keep
# it on SMTP_USER (defaults to "WonderApps <SMTP_USER>").
CONTACT_FROM="WonderApps <connect@wonderapps.biz>"

# --- WonderApps database (site copy + tracker history) -------------------------
# Reads need nothing: the project URL and publishable (read-only) key are in
# src/lib/content/supabase.ts. Override only to point at another project.
# WONDERAPPS_SUPABASE_URL=https://<ref>.supabase.co
# WONDERAPPS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The daily /api/cron/progress run writes with this key (only its SHA-256 is in the
# database, in private.write_keys). Also used by `npm run progress:backfill`, and by the
# founder dashboard to store and read its collected numbers (they are not public).
PROGRESS_WRITE_KEY=

# --- Optional -----------------------------------------------------------------
# Canonical site URL used for metadata and sitemap. Defaults to wonderapps.biz.
NEXT_PUBLIC_SITE_URL=https://wonderapps.biz

# --- Founder dashboard (/dashboard) -------------------------------------------
# Daily collection (and the Refresh button) reads each product's own database through a
# READ-ONLY role (create it with docs/dashboard/<product>-readonly.sql) and stores the
# aggregates in the WonderApps database; pages read only the stored copy.
# Use the pooled connection string of that role. Unset = that product shows "Not connected".
WONDERHOME_DATABASE_URL=
WONDERJOBS_DATABASE_URL=
WONDERCREATOR_DATABASE_URL=
WONDERARK_DATABASE_URL=
WONDERID_DATABASE_URL=
# Optional: PEM of the database's CA to verify TLS strictly (otherwise TLS is on, certificate unverified).
# WONDERHOME_DATABASE_CA=

# Who may sign in (comma-separated). Sign-in is a one-time emailed link; no passwords.
DASHBOARD_ALLOWED_EMAILS=you@wonderapps.biz
# Signs sessions and sign-in links. 32+ random characters: openssl rand -base64 48
DASHBOARD_SESSION_SECRET=
# Optional: bump to sign everyone out at once. Day boundaries for charts and newsletters.
# DASHBOARD_SESSION_VERSION=1
# DASHBOARD_TIMEZONE=Asia/Kolkata

# --- Newsletters (sent through the same SMTP mailbox) ---------------------------
# Who receives the automatic briefings (defaults to DASHBOARD_ALLOWED_EMAILS).
NEWSLETTER_RECIPIENTS=
# weekly, monthly, both or off. Weekly = Mondays 09:00 IST, monthly = the 1st (see vercel.json).
NEWSLETTER_CADENCE=weekly
# Sender; defaults to CONTACT_FROM.
# NEWSLETTER_FROM="WonderApps <connect@wonderapps.biz>"
# Vercel Cron sends this as a Bearer token. 16+ random characters. Required for automatic sends.
CRON_SECRET=

# Local design only (ignored in production): show synthetic numbers with no databases.
# DASHBOARD_DEMO=1

# Careers (/careers). The key is normally pasted at /dashboard/careers and stored encrypted;
# this is only the fallback when the database has none.
WONDERJOBS_CAREERS_KEY=
# Optional: a separate secret (32+ chars) for encrypting the stored key; defaults to DASHBOARD_SESSION_SECRET.
CAREERS_KEY_SECRET=
