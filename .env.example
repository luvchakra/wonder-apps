# --- Contact form (the only server-side feature on this static site) ---------
# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of inboxes that receive every contact-form submission.
CONTACT_RECIPIENTS=founder@example.com,partner@example.com

# The From address. Must be on a domain verified in Resend. Until you verify a
# domain, Resend lets you send from onboarding@resend.dev to your own account
# email only.
CONTACT_FROM="WonderApps <hello@yourdomain.com>"

# --- Optional -----------------------------------------------------------------
# Canonical site URL used for metadata and sitemap. Defaults to the Vercel URL.
NEXT_PUBLIC_SITE_URL=https://wonderapps.vercel.app
