# --- Contact form (the only server-side feature on this static site) ---------
# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of inboxes that receive every contact-form submission.
CONTACT_RECIPIENTS=connect@wonderapps.biz

# The From address. Must be on a domain verified in Resend. Until wonderapps.biz
# is verified there, Resend only lets you send from onboarding@resend.dev to
# your own account email.
CONTACT_FROM="WonderApps <connect@wonderapps.biz>"

# --- Optional -----------------------------------------------------------------
# Canonical site URL used for metadata and sitemap. Defaults to wonderapps.biz.
NEXT_PUBLIC_SITE_URL=https://wonderapps.biz
